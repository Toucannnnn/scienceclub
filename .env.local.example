# Copy this file to .env.local and fill in values from your Supabase project
# dashboard: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Phase 2: notifications ---------------------------------------------

# Project Settings -> API -> service_role key. Full-access, bypasses RLS —
# never expose this to the browser or commit it. Used only by the cron
# dispatch Route Handler, via src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# resend.com -> API Keys. Sends the actual notification emails.
RESEND_API_KEY=your-resend-api-key
# A sender address on a domain you've verified with Resend. For local
# testing without a verified domain, use onboarding@resend.dev.
RESEND_FROM_EMAIL=Science Peer Tutoring <notifications@your-verified-domain.org>

# A random secret shared with whatever schedules the notification dispatch
# route — generate one with: openssl rand -hex 32
CRON_SECRET=your-random-secret

# Absolute origin used to build links inside emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
